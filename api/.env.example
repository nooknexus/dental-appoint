API_PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinic_appoint_db
DB_USER=root
DB_PASSWORD=root
AUTH_MODE=mock
SESSION_SECRET=replace-this-before-deployment
MOPH_ALERT_ENCRYPTION_KEY=replace-with-a-strong-server-only-secret

# --- ล็อกอินผู้ป่วยด้วยหมอพร้อม (MOPH HealthID) ---
# เปิดใช้เมื่อกรอก credentials ด้านล่างครบแล้วเท่านั้น
PATIENT_SSO_ENABLED=false
# จากการลงทะเบียนที่ moph.id.th — MOPH_REDIRECT_URI ต้องตรงกับที่ลงทะเบียนไว้ byte-to-byte (HTTPS)
MOPH_CLIENT_ID=
MOPH_CLIENT_SECRET=
MOPH_REDIRECT_URI=https://your-domain/api/auth/patient/moph/callback
# ค่า scope ตามที่ลงทะเบียน (เอกสาร ProviderID ระบุค่า ProviderID — ยืนยันกับหน้าลงทะเบียน/ซัพพอร์ตก่อนใช้จริง)
MOPH_LOGIN_SCOPE=ProviderID
# ระดับ IAL ขั้นต่ำที่ยอมให้ล็อกอิน (1.3 = ยืนยันตัวตนด้วย Dipchip)
MIN_PATIENT_IAL=1.3
PATIENT_SESSION_HOURS=12
# ตั้ง true เมื่อ serve ผ่าน HTTPS จริง (production) เพื่อให้ cookie มีแฟล็ก Secure
COOKIE_SECURE=false

# --- ล็อกอินเจ้าหน้าที่ด้วย ProviderID ---
# เปลี่ยน AUTH_MODE=provider เมื่อกำหนด HealthID ด้านบนและ ProviderID credentials ครบแล้ว
# ใช้ MOPH_CLIENT_ID / MOPH_CLIENT_SECRET / MOPH_REDIRECT_URI และ callback เดียวกับผู้ป่วย
PROVIDER_CLIENT_ID=
PROVIDER_CLIENT_SECRET=
PROVIDER_EXCHANGE_ENDPOINT=https://provider.id.th/api/v1/services/token
PROVIDER_USERINFO_ENDPOINT=https://provider.id.th/api/v1/services/profile
STAFF_SESSION_HOURS=8

# --- ล็อกอินผู้ป่วยด้วย ThaiID (DOPA OIDC) ---
THAID_SSO_ENABLED=false
THAID_WELL_KNOWN_URL=https://imauth.bora.dopa.go.th/.well-known/openid-configuration
THAID_CLIENT_ID=
THAID_CLIENT_SECRET=
THAID_REDIRECT_URI=https://your-domain/api/auth/patient/thaid/callback
THAID_SCOPE=pid openid name name_en birthdate address
